.env*
!.env.example
.env.local
.env.*.local
*.json
!package.json
!package-lock.json
!packages/msgf/config/tenant-manifest.json
!packages/msgf-pulse-guard/resources/dev-kit/**/*.json
# TypeScript project files (required in Docker / Cloud Build; *.json above would exclude them)
!**/tsconfig.json
!**/tsconfig.*.json
node_modules/
dist/
.next/
**/.next/

# TypeScript incremental caches and local ingest logs (do not commit)
*.tsbuildinfo
ingest-log.txt

# Nested npm lockfiles — only the root package-lock.json should exist for npm workspaces
apps/**/package-lock.json
packages/**/package-lock.json

# Supabase CLI local cache (machine-specific; not for version control)
supabase/.temp/
packages/msgf/supabase/.temp/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
/tests/reports/
