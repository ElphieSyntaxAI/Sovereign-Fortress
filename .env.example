# Copy to .env.local at this repo root (same folder as this file) and fill in values from
# Supabase Dashboard → Project Settings → API.

# --- Supabase (shared by packages/msgf Next app + apps/author-ecosystem) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required on the author BFF: JWT signing secret (Dashboard → Settings → API → JWT Secret).
# Used to verify HS256 access tokens (`author_bff_jwt` / Authorization Bearer). Must match this project.
SUPABASE_JWT_SECRET=

# --- Author BFF (apps/author-ecosystem/server) ---
# Optional: legacy HMAC JWTs only (until fully retired).
JWT_SECRET=/3U6vtp1FpKySu9Lx/RuPpmY+0qoNPnELY+csvGBNqMlcM7b7JTBneNJ3ozEY26Ko3V9rG8i3oxE0ODX82BQFw==

# --- Optional: Vite-only names (author client). If unset, Vite maps from the vars above. ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# --- Optional: planning wiki dev (author client) ---
# VITE_PLANNING_MANUSCRIPT_ID=
# VITE_PLANNING_TENANT_ID=
