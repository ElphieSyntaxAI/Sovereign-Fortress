# Copy to .env.local at this repo root (same folder as this file) and fill in values from
# Supabase Dashboard → Project Settings → API.

# --- Supabase (shared by packages/msgf Next app + apps/author-ecosystem) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cloud Run / Docker: `NEXT_PUBLIC_*` is baked in at `next build`. `./setup-cloud.sh` passes
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY as Docker `--build-arg`
# from `.env.cloudrun` (copy env.cloudrun.example → .env.cloudrun; or `npm run deploy:cloudrun:env`).
# See docs/DEPLOY_PRODUCT_DOMAINS.md. Runtime-only Cloud Run env is not enough for the browser bundle.

# Cold layer schema (packages/msgf/supabase/migrations) — apply to remote Postgres:
#   npm run db:push
# Requires DATABASE_URL (Dashboard → Database → Connection string → URI), e.g.:
# Direct (migrations): postgresql://postgres:[YOUR-DB-PASSWORD]@db.[project-ref].supabase.co:5432/postgres
# Pooler: postgresql://postgres.[project-ref]:[password]@aws-1-us-west-2.pooler.supabase.com:6543/postgres
# SUPABASE_POOLER_REGION=us-west-2
# SUPABASE_POOLER_AWS_PREFIX=aws-1
# Do not use GCP region names (e.g. us-central1) in pooler hosts — copy the URI from the Supabase Dashboard.
# Or: SUPABASE_PROJECT_REF=your-ref  SUPABASE_DB_PASSWORD=...  SUPABASE_ACCESS_TOKEN=... (for supabase link)
# Then verify: npm run verify:supabase-schema

# Required on the author BFF: JWT signing secret (Dashboard → Settings → API → JWT Secret).
# Used to verify HS256 access tokens (`author_bff_jwt` / Authorization Bearer). Must match this project.
SUPABASE_JWT_SECRET=

# --- MSGF (packages/msgf — https://elphiesgatedai.elphiesyntax.com) ---
# --- Public app domain map ---
# Apex global hub:
#   https://elphiesyntax.com
# Product apps:
#   https://authorecosystem.elphiesyntax.com
#   https://syntaxeducates.elphiesyntax.com
#   https://elphiesgatedai.elphiesyntax.com
AUTHOR_APP_URL=https://authorecosystem.elphiesyntax.com
NEXT_PUBLIC_AUTHOR_APP_URL=https://authorecosystem.elphiesyntax.com
# Local dev (admin portal launcher — optional overrides)
# MSGF_LOCAL_DEV_URL=http://127.0.0.1:3001
# AUTHOR_CLIENT_DEV_URL=http://127.0.0.1:5173
# AUTHOR_ECOSYSTEM_URL=http://127.0.0.1:3002
EDUCATION_APP_URL=https://syntaxeducates.elphiesyntax.com
NEXT_PUBLIC_EDUCATION_APP_URL=https://syntaxeducates.elphiesyntax.com
# EDUCATION_LOCAL_DEV_URL=http://127.0.0.1:5175
# EDUCATION_TEACHER_DASHBOARD_URL=https://syntaxeducates.elphiesyntax.com/teacher
MSGF_APP_URL=https://elphiesgatedai.elphiesyntax.com
NEXT_PUBLIC_MSGF_APP_URL=https://elphiesgatedai.elphiesyntax.com
# Author client on temporary Google/static host can call a separate Author BFF:
# VITE_AUTHOR_BFF_URL=https://your-author-bff-service.run.app
# BFF_ALLOWED_ORIGINS=https://your-author-client-host.run.app,https://authorecosystem.elphiesyntax.com
# BFF_ALLOWED_ORIGIN_REGEX=^https://.*\\.run\\.app$
# Author BFF -> MSGF Pulse bridge. Set these on the Author BFF deployment.
# MSGF_APP_URL=https://your-msgf-service.run.app
# MSGF_AUTHOR_TENANT_ID=author_ecosystem
# MSGF_AUTHOR_PULSE_LICENSE_KEY=msgf_live_...
# MSGF_AUTHOR_HAL_PULSE_ENABLED=1

# --- MSGF (packages/msgf — https://elphiesgatedai.elphiesyntax.com) ---
# Phase 0: npm run verify:msgf-env -w msgf
# Vertex: place Google Cloud service account JSON at packages/msgf/service-account.json
#         (or set GOOGLE_APPLICATION_CREDENTIALS to that file path).

# V3.2 hot layer — P4 active slices + lineage cache (Redis). Start: docker compose up -d redis
# --- V3.2 SHARD hot layer (pick one backend) ---
# Upstash Redis REST (recommended for Cloud Run — no VPC connector):
# UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
# UPSTASH_REDIS_REST_TOKEN=YOUR_REST_TOKEN
# Local / Memorystore TCP:
REDIS_URL=redis://localhost:6379
# REDIS_HOST=10.x.x.x
# REDIS_PORT=6379
# MSGF_REQUIRE_REDIS=1
# Upstash Box (agent sandbox — NOT used for MSGF Pulse SHARD; separate product):
# UPSTASH_BOX_API_KEY=
# Scheduled V3.2 maintenance — POST /api/msgf/ops/v32-heartbeat (Cloud Scheduler / GitHub Actions):
# REQUIRED on server. Auth: Bearer or X-MSGF-Ops-Cron-Secret ONLY (no admin API key on this route).
# Runs: tier batches; scheduled heals for pillar_vectors with preset_interval 6h / nightly (LOM consensus + Vault);
# 30d Hall purge (Postgres + Upstash). Dry-run: POST body {"dry_run": true} with same secret.
# MSGF_OPS_CRON_SECRET=

# Tenant BYOK keys (/api/msgf/tenant/provider-keys): AES-256-GCM when NODE_ENV !== production.
# Use 32-byte UTF-8 secret OR 64-character hex (exactly 32 bytes decoded).
# CRYPTO_SECRET_KEY=
# Production: encrypt/decrypt uses Google Cloud KMS (GOOGLE_APPLICATION_CREDENTIALS + IAM).
# Full CryptoKey resource name, e.g. projects/PROJECT/locations/global/keyRings/RING/cryptoKeys/KEY
# MSGF_KMS_CRYPTO_KEY_PATH=

# Dual-model consensus gateway (local Pulse routing): requires BOTH Gemini + Anthropic tenant encrypted keys when enabled.
# Tenant validators run in parallel (Promise.all); agreement Dice score vs DUAL_MODEL_GATEWAY_AGREEMENT_THRESHOLD (0.8).
# Below threshold → SovereignAuditor (Vertex Master Gemini + Claude publisher APIs).
# MSGF_DUAL_MODEL_LOCAL_GATEWAY_ENABLED=false
# MSGF_TENANT_VALIDATION_GEMINI_MODEL=gemini-2.0-flash
# MSGF_TENANT_VALIDATION_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Optional Master Claude override for SovereignAuditor (defaults to MSGF_CLAUDE_MODEL).
# MSGF_SOVEREIGN_CLAUDE_MODEL=

# Billing (Phase 3+; required for Phase 0 env verify)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs for /pricing checkout (recreate — do not reuse $99 one-time)
# STRIPE_PRICE_PRO_INDIVIDUAL=price_...          # $29/mo subscription
# STRIPE_PRICE_PRO_INDIVIDUAL_YEARLY=price_...   # $290/yr subscription
# STRIPE_PRICE_STARTUP_TEAM=price_...            # $49/workspace/mo
# STRIPE_PRICE_STARTUP_TEAM_YEARLY=price_...     # $490/workspace/yr
# STRIPE_PRICE_ENTERPRISE=price_...              # $199/workspace/mo
# STRIPE_PRICE_ENTERPRISE_YEARLY=price_...       # $1,990/workspace/yr

# M3 entitlement guard (POST /api/msgf/pulse) — reads p4_profiles tier + credits + Stripe status
# Mock monthly subscription as active until webhook sets stripe_subscription_status (default mock ON).
MSGF_ENTITLEMENT_MOCK_STRIPE_ACTIVE=1
# Set to 1 when Stripe webhooks update p4_profiles.stripe_subscription_status in production.
# MSGF_STRIPE_WEBHOOK_LIVE=
# MSGF_ENTITLEMENT_GUARD_DISABLED=false

# Contract licenses (msgf_licenses) — mint with: npm run mint:license -w msgf
# Solo integrator bootstrap: npm run bootstrap:solo -w msgf (pledge + pillars + license; see docs/MSGF_SOLO_INTEGRATION.md)
# Requires SUPABASE_SERVICE_ROLE_KEY; plain key logged once by scripts/mint-license.mjs
# Pulse route: x-msgf-license-key or Authorization: Bearer msgf_live_... (or MSGF_CONTRACT_LICENSE_KEY)
# MSGF_PULSE_LICENSE_DISABLED=true
# MSGF_CONTRACT_LICENSE_KEY=
# MSGF_SOLO_TENANT_ID=integration_sandbox
# MSGF_SOLO_ENTITY_ID=

# Signing — team invites with "Enforce DocuSign" / policy sign-off (see docs/MSGF_SIGNING.md)
# Hidden from 1.0 unless MSGF_POST_MVP_SIGNING=1 (code stays; APIs 404 otherwise).
# MSGF_POST_MVP_SIGNING=0
# MSGF_POST_MVP_DROPBOX_ARCHIVE=0
# MSGF_POST_MVP_MCP=0
# AUTHOR_POST_MVP_FAN_HUB=0
# AUTHOR_POST_MVP_HELPER=0
# Mock both providers locally (do not set in production):
# MSGF_SIGNING_MOCK=1
# MSGF_DOCUSIGN_MOCK=1
# SIGNING_PROVIDER=docusign
# Company override: msgf_companies.signing_provider
# Live DocuSign eSignature (JWT grant):
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_RSA_PRIVATE_KEY=   # PEM or base64 one-line
# DOCUSIGN_USE_DEMO=1         # default demo hosts (account-d.docusign.com)
# DOCUSIGN_OAUTH_HOST=account-d.docusign.com
# DOCUSIGN_API_BASE=https://demo.docusign.net
# DOCUSIGN_TEAM_TEMPLATE_ID=  # optional; else inline HTML agreement
# DOCUSIGN_TEMPLATE_ROLE_NAME=Signer
# MSGF_DOCUSIGN_CONNECT_SECRET=  # HMAC for Connect webhook (x-docusign-signature-1)
# Connect URL: POST https://<MSGF_HOST>/api/msgf/ops/docusign-webhook
# Unified: POST https://<MSGF_HOST>/api/msgf/ops/signing-webhook?provider=docusign
# Dropbox Sign:
# DROPBOX_SIGN_API_KEY=
# DROPBOX_SIGN_TEST_MODE=1
# DROPBOX_SIGN_WEBHOOK_SECRET=
# DROPBOX_ACCESS_TOKEN=       # archive (I4+)
# DROPBOX_ARCHIVE_ROOT=/MSGF-Audit
# Dropbox webhook: POST https://<MSGF_HOST>/api/msgf/ops/dropbox-sign-webhook

# Sentry — SDK (errors + tracing) + ops panel + crash→Vault quarantine (docs/MSGF_SENTRY.md)
# SDK DSN (required for @sentry/nextjs — same value on client + server is fine):
# NEXT_PUBLIC_SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
# Build-time source maps (withSentryConfig):
# SENTRY_ORG=          # or reuse SENTRY_ORG_SLUG
# SENTRY_PROJECT=      # or reuse SENTRY_PROJECT_SLUG
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG_SLUG=
# SENTRY_PROJECT_SLUG=        # optional default project filter
# SENTRY_BASE_URL=https://sentry.io
# SENTRY_WEBHOOK_SECRET=      # Bearer or x-sentry-webhook-secret for POST /api/msgf/ops/sentry-webhook
# SENTRY_VAULT_MATCH_THRESHOLD=0.75

# Google Workspace SSO (I3) — docs/MSGF_GOOGLE_WORKSPACE_SSO.md
# Enable Google provider in Supabase Auth first.
# NEXT_PUBLIC_GOOGLE_WORKSPACE_HD=acme.com
# MSGF_GOOGLE_WORKSPACE_SSO=1
# GOOGLE_SSO_CIRCUIT_FAILURES=5
# GOOGLE_SSO_CIRCUIT_WINDOW_SEC=300
# MSGF_DEPLOY_GATE_MAX_AGE_HOURS=72
# I5 archive worker mock (no Dropbox token needed):
# MSGF_DROPBOX_ARCHIVE_MOCK=1

# M4 Ops — admin incidents API (GET/PATCH /api/msgf/admin/incidents)
# Authorization: Bearer <SUPABASE_SERVICE_ROLE_KEY> or MSGF_ADMIN_API_KEY
# MSGF_ADMIN_API_KEY=
# Optional bootstrap for `/admin/sign-in`:
# MSGF_GLOBAL_ADMIN_EMAILS=jessicapickens@elphiesyntax.com
# Individual (non-team) operators — COMPANY_ADMIN on a personal sandbox, not GLOBAL_ADMIN:
# MSGF_INDIVIDUAL_ADMIN_EMAILS=jessica@dealstar.io
# Optional: Author App webhook when ops Rejects a Pulse (POST notify-reject)
# MSGF_AUTHOR_PULSE_REJECT_WEBHOOK_URL=http://127.0.0.1:3002/api/internal/msgf/pulse-rejected
# MSGF_AUTHOR_PULSE_REJECT_WEBHOOK_SECRET=
# Author registration → MSGF onboarding (msgf/onboarding after Vault Pact RPC)
# MSGF_AUTHOR_REGISTRATION_BILLING_LICENSE=monthly
# MSGF_AUTHOR_REGISTRATION_STRIPE_STATUS=active
# MSGF_AUTHOR_REGISTRATION_STARTER_CREDITS=25
# HITL incident strategies (Vertex pre-gen on 1.1.1_HITL_TIEBREAKER)
# MSGF_HITL_STRATEGIES_DISABLED=false

# BATCH Logic Drift — npm run daily-report -w msgf (service role + narrative logs)

# Automatic Purge (Hall drift >30d, keeps RED) — scripts/ops-purge-hall.mjs
# Preview: npm run ops:purge-hall -w msgf -- --dry-run
# Execute: npm run ops:purge-hall -w msgf -- --yes

# Staging LOM / recursion harness (set to 1 or true before test:lom-disagreement)
MSGF_ENABLE_LOM_TEST=

# Global Approval Gate — admin tenant for vault_core + global_msgf_rules promotion
# MSGF_VAULT_CORE_TENANT_ID=msgf_admin
# MSGF_LOCAL_STATE_CACHE_TTL_SEC=1209600
# Optional default operator id when POST /api/msgf/admin/promotions/approve has no x-msgf-promoted-by / body.promoted_by_actor_id
# MSGF_PROMOTION_DEFAULT_ACTOR=
# Entity id for Global Insight → vault_core absorbs (defaults to deterministic placeholder if unset)
# MSGF_GLOBAL_INSIGHT_SYSTEM_ENTITY_ID=

# MSGF distribution traceability (license headers + dist banner — npm run license:stamp -w msgf)
# MSGF_DISTRIBUTION_ID=acme-qa-cohort-01
# MSGF_TESTER_ID=
# MSGF_BUILD_ID=

# Tenant governance (x-msgf-tenant-id on /api/msgf/* — see packages/msgf/app/api/middleware.ts)
# PRODUCTION_AUTHOR: browser Origin/Referer must match (comma-separated; trailing slashes stripped)
# MSGF_PRODUCTION_AUTHOR_ALLOWED_ORIGINS=https://elphiesyntax.com,https://www.elphiesyntax.com,http://localhost:3002
# Allow server-to-server calls with no Origin header (IDE, cron, service role proxies)
# MSGF_PRODUCTION_AUTHOR_ALLOW_MISSING_ORIGIN=1
# DEV_TEST: POST/PUT/PATCH/DELETE set x-msgf-write-target: sandbox → msgf_sandbox table

# Server-to-server ingest when tenant API keys are enabled
MSGF_INGEST_API_KEY=

# Optional MSGF runtime
# MSGF_APP_URL=http://127.0.0.1:3001
# MSGF_BASE_URL=http://127.0.0.1:3001
# MSGF_LOCAL_DEV_URL=http://127.0.0.1:3001
# Supabase session cookies — required for sign-in on Cloud Run (*.run.app):
# MSGF_AUTH_COOKIE_DOMAIN=host
# NEXT_PUBLIC_MSGF_AUTH_COOKIE_DOMAIN=host
# Custom domain shared across subdomains only:
# MSGF_AUTH_COOKIE_DOMAIN=.elphiesyntax.com
# NEXT_PUBLIC_MSGF_AUTH_COOKIE_DOMAIN=.elphiesyntax.com
# MSGF_AUTH_COOKIE_SECURE=1
# NEXT_PUBLIC_MSGF_AUTH_COOKIE_SECURE=1
# After sign-in redirect (default /todos; no /dashboard route unless you add it):
# NEXT_PUBLIC_MSGF_POST_LOGIN_PATH=/todos
# MSGF_BILLING_SOFT_CAP_USD=50
# MSGF_CREDIT_GUARD_DISABLED=false
# Tenant token wallet + ledger RPCs (migration 20260531100000). Seed msgf_tenant_token_wallet before enforcing.
# MSGF_CREDIT_RESERVATION_ENABLED=false
# PAID_INDIVIDUAL CONVERGE monthly soft-cap + per-run ledger debit (tokens).
# MSGF_PAID_INDIVIDUAL_MONTHLY_TOKEN_SOFT_CAP=250000
# MSGF_PAID_INDIVIDUAL_CONVERGE_DEBIT=1000
# MSGF_INGEST_TENANT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=
# GCP_PROJECT_ID=
# GCP_LOCATION=us-central1

