# Staging Cloud Run — copy to .env.cloudrun.staging (gitignored). Never commit secrets.
# See docs/STAGING_AND_RELEASE.md

GCP_PROJECT_ID=msgf-shield
GCP_REGION=us-central1
DEPLOY_ENV=staging

# --- Staging public URLs (baked into Next/Vite at image build time) ---
# Option A: custom staging subdomains (after domain mapping)
NEXT_PUBLIC_MSGF_APP_URL=https://staging.elphiesgatedai.elphiesyntax.com
MSGF_APP_URL=https://staging.elphiesgatedai.elphiesyntax.com
MSGF_BASE_URL=https://staging.elphiesgatedai.elphiesyntax.com

NEXT_PUBLIC_AUTHOR_APP_URL=https://staging.authorecosystem.elphiesyntax.com
AUTHOR_APP_URL=https://staging.authorecosystem.elphiesyntax.com
VITE_AUTHOR_APP_URL=https://staging.authorecosystem.elphiesyntax.com
AUTHOR_ECOSYSTEM_URL=https://staging.authorecosystem.elphiesyntax.com

# Picker on staging apex (optional — or use staging.authorecosystem only)
# NEXT_PUBLIC_AUTHOR_APP_URL=https://staging.elphiesyntax.com

NEXT_PUBLIC_EDUCATION_APP_URL=https://staging.syntaxeducates.elphiesyntax.com
EDUCATION_APP_URL=https://staging.syntaxeducates.elphiesyntax.com

# BFF — use mapped staging API host or Cloud Run URL until DNS is ready
VITE_AUTHOR_BFF_URL=https://staging-api.authorecosystem.elphiesyntax.com
AUTHOR_BFF_URL=https://staging-api.authorecosystem.elphiesyntax.com
BFF_ALLOWED_ORIGINS=https://staging.authorecosystem.elphiesyntax.com,https://staging.elphiesyntax.com,https://staging.elphiesgatedai.elphiesyntax.com

# --- Staging Supabase (separate project recommended) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Staging Redis (separate Upstash DB recommended) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe TEST mode only on staging
# STRIPE_SECRET_KEY=sk_test_...

# Ops / admin (same operators OK)
# MSGF_GLOBAL_ADMIN_EMAILS=you@example.com
# MSGF_OPS_CRON_SECRET=
# RESEND_API_KEY=

# Cookie domain — only if staging lives on *.elphiesyntax.com
# MSGF_AUTH_COOKIE_DOMAIN=.elphiesyntax.com
