{
  "name": "elphie-syntax-suite",
  "scripts": {
    "dev": "npm run dev -w msgf",
    "dev:msgf": "npm run dev -w msgf",
    "dev:dashboard": "npm run dev -w msgf-dashboard",
    "clean:artifacts": "node tools/clean-artifacts.js",
    "consolidate:locks": "node tools/remove-nested-package-locks.js && npm install",
    "consolidate:locks:pnpm": "node tools/remove-nested-package-locks.js && npx --yes pnpm@9 import && node -e \"try{require('fs').unlinkSync(require('path').join(process.cwd(),'package-lock.json'));}catch(_){}\" && npx --yes pnpm@9 install",
    "check-brain-violation": "node tools/check-brain-violation.js",
    "enforce-silo": "node tools/enforce-silo.js",
    "prepare": "node tools/enforce-silo.js install",
    "security:prancer-pillars": "node packages/msgf/scripts/security-primer-pillars.mjs",
    "verify:supabase-schema": "npm run verify:db-schema -w msgf"
  },
  "workspaces": [
    "packages/*",
    "apps/msgf-dashboard",
    "apps/client-vortex/web",
    "apps/client-vortex/server",
    "apps/author-ecosystem/client",
    "apps/author-ecosystem/server"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "cross-env": "^7.0.3",
    "next": "^15.1.0",
    "stripe": "^22.1.1"
  }
}
