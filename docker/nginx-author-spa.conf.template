server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # MSGF handoff JWTs in query strings can exceed default 8k header limits.
    large_client_header_buffers 4 32k;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Same-origin /api → Author BFF (avoids third-party cookies + broken api.* DNS).
    location /api/ {
        proxy_pass ${AUTHOR_BFF_UPSTREAM}/api/;
        proxy_ssl_server_name on;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_set_header Host ${AUTHOR_BFF_PROXY_HOST};
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Cookie $http_cookie;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
