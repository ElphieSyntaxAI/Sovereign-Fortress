server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # MSGF handoff POST carries large cross-site Cookie headers from elphiesgatedai.
    large_client_header_buffers 8 64k;
    client_header_buffer_size 16k;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Same-origin /api → Author BFF (avoids third-party cookies + broken api.* DNS).
    location /api/ {
        proxy_pass ${AUTHOR_BFF_UPSTREAM}/api/;
        proxy_ssl_server_name on;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        # setSession handoff returns many large Set-Cookie headers (Supabase chunks + BFF mirror).
        proxy_buffer_size 512k;
        proxy_buffers 8 512k;
        proxy_busy_buffers_size 512k;
        proxy_set_header Host ${AUTHOR_BFF_PROXY_HOST};
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Cookie $http_cookie;
    }

    # MSGF SSO handoff — do not forward MSGF session cookies to BFF (BFF ignores them anyway).
    location = /api/auth/msgf-handoff {
        proxy_pass ${AUTHOR_BFF_UPSTREAM}/api/auth/msgf-handoff;
        proxy_ssl_server_name on;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffer_size 512k;
        proxy_buffers 8 512k;
        proxy_busy_buffers_size 512k;
        proxy_set_header Host ${AUTHOR_BFF_PROXY_HOST};
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Cookie "";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
