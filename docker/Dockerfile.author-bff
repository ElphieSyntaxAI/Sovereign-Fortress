# Author BFF — monorepo production image (Cloud Run, PORT=8080).
# Build from repo root:
#   docker build -f docker/Dockerfile.author-bff -t author-bff:latest .

FROM node:20-bookworm-slim AS deps

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps ./apps
COPY tools ./tools

RUN npm ci --no-audit --no-fund \
  && mkdir -p /app/packages/msgf/node_modules

FROM node:20-bookworm-slim AS production

WORKDIR /app

ENV NODE_ENV=production
# Cloud Run sets PORT=8080; default here helps local `docker run` without -e PORT.
ENV PORT=8080
# Resolve `msgf/*` to TypeScript sources (development export). The bundled `dist/` pulls in
# `next/server` and crashes the BFF when started with tsx on Cloud Run.
ENV NODE_OPTIONS=--conditions=development

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/msgf/node_modules ./packages/msgf/node_modules
COPY package.json package-lock.json ./
COPY tsconfig.json ./tsconfig.json
COPY packages ./packages
COPY apps ./apps
COPY tools ./tools

EXPOSE 8080

# Repo-root tsconfig maps @/* → packages/msgf/* for tsx (author server tsconfig has no paths).
CMD ["npx", "tsx", "--tsconfig", "tsconfig.json", "apps/author-ecosystem/server/src/main.ts"]
