# Author Vite SPA — static nginx on Cloud Run (PORT=8080).
# Build from repo root; pass VITE_* as --build-arg (see setup-author-cloud.sh).

FROM node:20-bookworm-slim AS builder

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps ./apps
COPY tools ./tools
# Legal markdown must be present for Vite ?raw imports (see .dockerignore exceptions)
COPY apps/author-ecosystem/nda ./apps/author-ecosystem/nda
COPY apps/author-ecosystem/terms ./apps/author-ecosystem/terms

RUN npm ci --no-audit --no-fund \
  && mkdir -p /app/packages/msgf/node_modules

ARG VITE_SUPABASE_URL=
ARG VITE_SUPABASE_ANON_KEY=
ARG VITE_AUTHOR_BFF_URL=
ARG VITE_AUTHOR_APP_URL=
ARG VITE_MSGF_APP_URL=
ARG VITE_EDUCATION_APP_URL=
ARG VITE_AUTHOR_POST_MVP_FAN_HUB=0
ARG VITE_AUTHOR_POST_MVP_HELPER=0

ENV VITE_SUPABASE_URL=${VITE_SUPABASE_URL}
ENV VITE_SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY}
ENV VITE_AUTHOR_BFF_URL=${VITE_AUTHOR_BFF_URL}
ENV VITE_AUTHOR_APP_URL=${VITE_AUTHOR_APP_URL}
ENV VITE_MSGF_APP_URL=${VITE_MSGF_APP_URL}
ENV VITE_EDUCATION_APP_URL=${VITE_EDUCATION_APP_URL}
ENV VITE_AUTHOR_POST_MVP_FAN_HUB=${VITE_AUTHOR_POST_MVP_FAN_HUB}
ENV VITE_AUTHOR_POST_MVP_HELPER=${VITE_AUTHOR_POST_MVP_HELPER}
ENV NEXT_PUBLIC_SUPABASE_URL=${VITE_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${VITE_SUPABASE_ANON_KEY}
ENV AUTHOR_APP_URL=${VITE_AUTHOR_APP_URL}
ENV MSGF_APP_URL=${VITE_MSGF_APP_URL}

RUN npm run build -w @elphie-syntax/author-ecosystem-client \
  && npm run build:handoff -w @elphie-syntax/author-ecosystem-client \
  && test -f /app/apps/author-ecosystem/client/dist/handoff-bridge.js

FROM nginx:1.27-alpine AS production

ARG AUTHOR_BFF_UPSTREAM=https://author-bff-bkracxai6q-uc.a.run.app

RUN apk add --no-cache gettext

COPY docker/nginx-author-spa.conf.template /tmp/default.conf.template
RUN BFF_UP="$(echo "${AUTHOR_BFF_UPSTREAM}" | sed 's|/$||')" \
  && export AUTHOR_BFF_UPSTREAM="${BFF_UP}" \
  && export AUTHOR_BFF_PROXY_HOST="$(echo "${BFF_UP}" | sed -e 's|^https://||' -e 's|^http://||')" \
  && envsubst '${AUTHOR_BFF_UPSTREAM} ${AUTHOR_BFF_PROXY_HOST}' < /tmp/default.conf.template > /etc/nginx/conf.d/default.conf \
  && rm /tmp/default.conf.template \
  && nginx -t

COPY --from=builder /app/apps/author-ecosystem/client/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
