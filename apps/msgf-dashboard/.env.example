# --- MSGF admin API (ARBITRATE queue) ---
# Live Cloud Run (production): https://msgf-api-bkracxai6q-uc.a.run.app
#
# Local dev (`npm run dev -w msgf-dashboard` on http://localhost:8080):
#   Leave VITE_MSGF_API_BASE_URL unset — Vite proxies `/api` and `/api/msgf` to Cloud Run
#   (see vite.config.ts). Authorization Bearer is injected from:
#     packages/msgf/.env.local → SUPABASE_SERVICE_ROLE_KEY  (preferred for local dev)
#     or dashboard / root env: MSGF_ADMIN_API_KEY, MSGF_ADMIN_BEARER_TOKEN
#
# Optional proxy target override (server-only, not bundled):
# MSGF_API_ORIGIN=https://msgf-api-bkracxai6q-uc.a.run.app

# Production / preview build: direct calls to Cloud Run (default when unset in build mode).
# VITE_MSGF_API_BASE_URL=https://msgf-api-bkracxai6q-uc.a.run.app

# VITE_MSGF_OPERATOR_USER_ID=<supabase-auth-user-uuid>
# Maps the dashboard browser session to p4_profiles.msgf_access_role (GLOBAL_ADMIN | COMPANY_ADMIN | DEVELOPER).
# When unset, the API treats the caller as a legacy global operator (full tenant health).

# NEVER ship service-role keys in VITE_* for public builds. Internal-only fallback:
# VITE_MSGF_ADMIN_BEARER_TOKEN=

# Optional: override Vortex Client health URL (default http://localhost:3010/api/health).
# VITE_VORTEX_CLIENT_HEALTH_URL=https://your-vortex-host.example/api/health

# Optional: override or extend modular tenants by id (JSON array). Same id replaces defaults.
# VITE_MODULAR_TENANTS_JSON=[{"id":"vortex","label":"Vortex Client","url":"https://your-vortex-host.example/api/health"}]

# COMPANY_ADMIN Local Law Book panel
# VITE_MSGF_LAW_BOOK_TENANT_ID=<tenant-uuid>

# Dev-only dashboard gate (never enable in production builds)
# VITE_DEV_ADMIN_EMAIL=you@example.com
# VITE_DEV_ADMIN_PASSWORD=change-me
