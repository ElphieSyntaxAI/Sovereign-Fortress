{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": false,
    /**
     * Resolve the `msgf` package via its `"development"` export condition so
     * the TS compiler reads `msgf/lib/*.ts` sources directly (no built
     * `packages/msgf/dist/` required for monorepo typecheck). Production
     * `tsx`/`tsc` builds still emit JS that resolves via `import` / `default`.
     */
    "customConditions": ["development"]
  },
  "include": ["src/**/*.ts"]
}
