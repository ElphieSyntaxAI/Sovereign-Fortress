# Author Ecosystem BFF — copy to `.env` or merge from monorepo `packages/msgf/.env.local`

PORT=3002

# Supabase: put ALL keys in packages/msgf/.env.local (BFF loads that file last).
# REQUIRED: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, SUPABASE_SERVICE_ROLE_KEY
# OPTIONAL: SUPABASE_JWT_SECRET (legacy HS256 verify only — not needed with new publishable + secret keys)
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# MSGF bridge (required for HAL chunk-pulse → Pulse and ingest)
# Copy MSGF_APP_URL + Supabase keys from packages/msgf/.env.local; mint license:
#   npm run bootstrap:author-msgf -w msgf
# MSGF dev defaults to :3001 (port :3000 often used by LIFF / other local apps)
MSGF_APP_URL=http://127.0.0.1:3001
MSGF_AUTHOR_TENANT_ID=author_ecosystem
MSGF_AUTHOR_PULSE_LICENSE_KEY=
# MSGF_CONTRACT_LICENSE_KEY=   # fallback if AUTHOR key unset
MSGF_AUTHOR_HAL_PULSE_ENABLED=1
# Count dev-session flushes toward token-savings counters (local stress test)
MSGF_AUTHOR_DEV_SESSION=1
MSGF_INGEST_API_KEY=
MSGF_INGEST_TENANT_ID=author_ecosystem
# Shadow preflight on document ingest commit (Hall/Vault cross-ref). Set off to disable.
# MSGF_DOCUMENT_INGEST_SHADOW=off
# Document ingest: converge (default) | hybrid | heuristic
# MSGF_DOCUMENT_INGEST_MODE=converge
# Auto-sync wiki/outline shards to MSGF brain on commit (default on when pulse license ready)
# MSGF_DOCUMENT_INGEST_SYNC_BRAIN=1
# Optional soft keyword hints (comma list or JSON {"hints":["scene card"],"planning_layers":["chapter_breakdown"]})
# MSGF_DOCUMENT_INGEST_KEYWORDS=chapter breakdown,scene card,split pov

# MSGF Shadow Proxy / Active Governance for Librarian (OpenAI) + Critic (Anthropic)
# Default when license+URL set: shadow (projected savings). Use active for live cuts.
# MSGF_AUTHOR_GATEWAY_MODE=shadow
# MSGF_AUTHOR_GATEWAY_MODE=active
# MSGF_AUTHOR_ACTIVE_AGGRESSIVENESS=shard-and-route
# Enforce MSGF deploy-gate before editor hub unlock (needs MSGF_OPS_CRON_SECRET)
# MSGF_AUTHOR_REQUIRE_DEPLOY_GATE=1
# MSGF_OPS_CRON_SECRET=
# Hybrid KEM 0x03 on Vault Pact attestation metadata (keys live on MSGF side)
# MSGF_HYBRID_KEM_ENABLED=1

# Optional cookie domain when Author and MSGF share a parent domain
# MSGF_AUTH_COOKIE_DOMAIN=.elphiesyntax.com
# MSGF_AUTH_COOKIE_SECURE=1
