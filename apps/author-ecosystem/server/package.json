{
  "name": "@elphie-syntax/author-ecosystem-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "sync:google-manuscript": "tsx src/lib/fetchManuscript.ts",
    "migrate:legacy-users": "tsx --env-file-if-exists=../../../.env.local --env-file-if-exists=../../../.env src/scripts/migrate-legacy-users.ts",
    "verify:bff-env": "tsx --env-file-if-exists=../../../.env.local --env-file-if-exists=../../../.env src/scripts/verify-bff-env.ts",
    "test:supabase-p4": "tsx --env-file-if-exists=../../../.env.local --env-file-if-exists=../../../.env src/scripts/verify-supabase-credentials.ts",
    "test": "tsx --test tests/author-workflows.test.ts",
    "test:smoke": "cross-env AUTHOR_BFF_SMOKE=1 tsx --test tests/author-workflows.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@elphie-syntax/core": "file:../../../packages/core",
    "@googleapis/drive": "^20.1.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.49.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "msgf": "file:../../../packages/msgf",
    "multer": "^1.4.5-lts.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
