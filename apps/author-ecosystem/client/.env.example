# Author Vite client — optional overrides (Supabase keys usually come from packages/msgf/.env.local via vite.config.js)

# MSGF dev brain while coding Author (defaults to http://127.0.0.1:3001 in vite.config.js)
# VITE_MSGF_APP_URL=http://127.0.0.1:3001

# When the UI is hosted separately from the BFF (production / Cloud Run testing), set the BFF origin:
# VITE_AUTHOR_BFF_URL=https://your-author-bff-xxxxx.run.app

# Local dev: leave unset — vite proxies /api → http://127.0.0.1:3002 (BFF must be running).
# Full stack: npm run dev:author-msgf  (MSGF :3001 + BFF :3002 + client :5173)
