# Copy to .env.cloudrun at repo root (gitignored). Used by setup-cloud.sh and setup-author-cloud.sh.
# Fill from Supabase Dashboard → Project Settings → API. Never commit the real file.

GCP_PROJECT_ID=msgf-shield
GCP_REGION=us-central1

# --- Public product URLs (baked into Next/Vite at image build time) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

NEXT_PUBLIC_AUTHOR_APP_URL=https://authorecosystem.elphiesyntax.com
NEXT_PUBLIC_EDUCATION_APP_URL=https://syntaxeducates.elphiesyntax.com
NEXT_PUBLIC_MSGF_APP_URL=https://elphiesgatedai.elphiesyntax.com

AUTHOR_APP_URL=https://authorecosystem.elphiesyntax.com
MSGF_APP_URL=https://elphiesgatedai.elphiesyntax.com

# Author Vite client (setup-author-cloud.sh — build-args)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_AUTHOR_APP_URL=https://authorecosystem.elphiesyntax.com
VITE_MSGF_APP_URL=https://elphiesgatedai.elphiesyntax.com
# Set after first author-bff deploy, or use your mapped API host:
VITE_AUTHOR_BFF_URL=https://api.authorecosystem.elphiesyntax.com
# MSGF admin handoff → Author SPA /api (nginx proxies to BFF). Use api.* only after DNS is mapped.
AUTHOR_BFF_URL=https://authorecosystem.elphiesyntax.com
AUTHOR_ECOSYSTEM_URL=https://authorecosystem.elphiesyntax.com
# Author client Cloud Run: upstream for nginx /api proxy (your author-bff *.run.app URL)
# AUTHOR_BFF_UPSTREAM=https://author-bff-xxxxx-uc.a.run.app

# --- MSGF Cloud Run runtime (elphiesgatedai) ---
MSGF_APP_URL=https://elphiesgatedai.elphiesyntax.com
MSGF_BASE_URL=https://elphiesgatedai.elphiesyntax.com
MSGF_AUTH_COOKIE_DOMAIN=.elphiesyntax.com
NEXT_PUBLIC_MSGF_AUTH_COOKIE_DOMAIN=.elphiesyntax.com
MSGF_AUTH_COOKIE_SECURE=1
NEXT_PUBLIC_MSGF_AUTH_COOKIE_SECURE=1

# Upstash REST (recommended on Cloud Run — no VPC Redis required)
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# Or Memorystore / TCP via VPC connector (see setup-cloud.sh):
# REDIS_URL=redis://10.x.x.x:6379

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Author BFF requires publishable + service role on Cloud Run (setup-author-cloud.sh deploys these):
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are copied from the lines above
# when only VITE_* keys are set — or set them explicitly here.

# Author BFF runtime
BFF_ALLOWED_ORIGINS=https://authorecosystem.elphiesyntax.com,https://elphiesgatedai.elphiesyntax.com
MSGF_AUTHOR_TENANT_ID=author_ecosystem
MSGF_AUTHOR_PULSE_LICENSE_KEY=msgf_live_
MSGF_AUTHOR_HAL_PULSE_ENABLED=1
# MSGF_AUTHOR_DEV_SESSION=0

# Optional: production Author → MSGF ingest on document commit
# MSGF_DOCUMENT_INGEST_SYNC_BRAIN=0

# MSGF production-author tenant CORS (comma-separated)
MSGF_PRODUCTION_AUTHOR_ALLOWED_ORIGINS=https://authorecosystem.elphiesyntax.com,https://elphiesgatedai.elphiesyntax.com,https://elphiesyntax.com,https://www.elphiesyntax.com

# Credit reservation — 402 before expensive Pulse / heal-queue cloud actions
MSGF_CREDIT_RESERVATION_ENABLED=1
MSGF_CREDIT_RESERVATION_PROD_DEFAULT=1
# MSGF_HEAL_RESERVE_CHUNK=400

# Domain mapping (map-product-domains.sh) — DNS must point to Google before mapping succeeds
MSGF_DOMAIN=elphiesgatedai.elphiesyntax.com
AUTHOR_CLIENT_DOMAIN=authorecosystem.elphiesyntax.com
AUTHOR_BFF_DOMAIN=api.authorecosystem.elphiesyntax.com
# Platform hub picker (same author-client service). Point apex DNS away from Squarespace first.
AUTHOR_APEX_DOMAIN=elphiesyntax.com
AUTHOR_APEX_WWW_DOMAIN=www.elphiesyntax.com

# Project setup: monorepo presets on /setup/projects (default: @elphiesyntax.com + MSGF_GLOBAL_ADMIN_EMAILS only)
# MSGF_MONOREPO_PRESET_EMAIL_SUFFIXES=elphiesyntax.com
# MSGF_SHOW_MONOREPO_PRESETS=1
