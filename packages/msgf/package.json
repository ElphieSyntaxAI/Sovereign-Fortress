    "aws-jwt-verify": "^5.1.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "ioredis": "^5.10.1",
    "jose": "^5.10.0",
    "next": "^15.1.0",
    "node-fetch": "^3.3.2",
    "openai": "^6.35.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "redis": "^5.12.1",
    "stripe": "^22.1.1",
    "tailwind-merge": "^2.6.0",
