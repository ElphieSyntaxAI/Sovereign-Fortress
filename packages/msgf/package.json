{
  "name": "msgf",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "index.ts",
    "instrumentation.ts",
    "app",
    "lib",
    "ui",
    "src",
    "utils",
    "middleware.ts",
    "next.config.ts",
    "msgf-init.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./lib/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lib/msgf-auth-cookies": {
      "types": "./dist/lib/msgf-auth-cookies.d.ts",
      "development": "./lib/msgf-auth-cookies.ts",
      "import": "./dist/lib/msgf-auth-cookies.js",
      "default": "./dist/lib/msgf-auth-cookies.js"
    },
    "./lib/platform-persona-auth": {
      "types": "./dist/lib/platform-persona-auth.d.ts",
      "development": "./lib/platform-persona-auth.ts",
      "import": "./dist/lib/platform-persona-auth.js",
      "default": "./dist/lib/platform-persona-auth.js"
    },
    "./universal/p1-hal-standard": {
      "types": "./dist/universal/p1-hal-standard.d.ts",
      "development": "./src/lib/universal/p1HalStandard.ts",
      "import": "./dist/universal/p1-hal-standard.js",
      "default": "./dist/universal/p1-hal-standard.js"
    },
    "./connector": {
      "types": "./dist/connector.d.ts",
      "development": "./lib/connector/client.ts",
      "import": "./dist/connector.js",
      "default": "./dist/connector.js"
    },
    "./connector/server": {
      "types": "./dist/connector/server.d.ts",
      "development": "./lib/connector/server.ts",
      "import": "./dist/connector/server.js",
      "default": "./dist/connector/server.js"
    },
    "./connector/MsgfBridge": {
      "types": "./dist/connector/MsgfBridge.d.ts",
      "development": "./lib/connector/MsgfBridge.ts",
      "import": "./dist/connector/MsgfBridge.js",
      "default": "./dist/connector/MsgfBridge.js"
    },
    "./onboarding": {
      "types": "./dist/onboarding.d.ts",
      "development": "./lib/msgf-onboarding.ts",
      "import": "./dist/onboarding.js",
      "default": "./dist/onboarding.js"
    },
    "./remediation": {
      "types": "./dist/remediation.d.ts",
      "development": "./lib/services/RemediationEngine.ts",
      "import": "./dist/remediation.js",
      "default": "./dist/remediation.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "development": "./ui/index.ts",
      "import": "./dist/ui.js",
      "default": "./dist/ui.js"
    },
    "./ide-connector": {
      "types": "./dist/ide-connector.d.ts",
      "development": "./lib/ide-connector.ts",
      "import": "./dist/ide-connector.js",
      "default": "./dist/ide-connector.js"
    }
  },
  "scripts": {
    "predev": "node msgf-init.cjs",
    "prebuild": "node msgf-init.cjs",
    "prestart": "node msgf-init.cjs",
    "license:stamp": "node scripts/apply-license-headers.mjs",
    "build:id": "node scripts/print-build-id.mjs",
    "build:sdk": "tsup && node ../../node_modules/cross-env/src/bin/cross-env.js MSGF_SDK_DTS_ONLY=1 tsup && node scripts/generate-server-dts.mjs",
    "build:sdk:prod": "npm run license:stamp && node ../../node_modules/cross-env/src/bin/cross-env.js NODE_ENV=production MSGF_SDK_PRODUCTION=1 npm run build:sdk && node scripts/obfuscate-dist.mjs && npm run verify:sdk-dist",
    "build:sdk:watch": "tsup --watch",
    "verify:sdk-dist": "node scripts/verify-sdk-dist.mjs",
    "_next": "node scripts/run-next.mjs",
    "dev": "npm run _next -- dev",
    "build": "npm run build:sdk:prod && npm run _next -- build",
    "start": "npm run _next -- start",
    "lint": "npm run _next -- lint",
    "test:lom-disagreement": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --env-file-if-exists=.env --env-file-if-exists=.env.local tests/test-lom-disagreement.ts",
    "verify:brain-routing": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-brain-routing.ts",
    "verify:msgf-env": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-msgf-env.mjs",
    "verify:connector-client": "node scripts/verify-connector-client.mjs",
    "mint:license": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/mint-license.mjs",
    "daily-report": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/daily-report.mjs",
    "ops:purge-hall": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ops-purge-hall.mjs",
    "verify:db-schema": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-supabase-schema.mjs",
    "db:push": "node scripts/supabase-db-push.mjs",
    "db:push:verify": "node scripts/supabase-db-push.mjs && npm run verify:db-schema",
    "security:prancer-pillars": "node scripts/security-primer-pillars.mjs",
    "probe:author-ecosystem": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/probe-author-ecosystem.mjs",
    "test:jira": "node scripts/test-jira.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@elphie-syntax/core": "file:../core",
    "@google-cloud/aiplatform": "^6.7.0",
    "@google-cloud/kms": "^5.5.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^3.9.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@tailwindcss/postcss": "^4.1.4",
    "aws-jwt-verify": "^5.1.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "ioredis": "^5.10.1",
    "jose": "^5.10.0",
    "next": "^15.1.0",
    "node-fetch": "^3.3.2",
    "openai": "^6.35.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "redis": "^5.12.1",
    "stripe": "^22.1.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "javascript-obfuscator": "^4.2.2",
    "pg": "^8.13.1",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
