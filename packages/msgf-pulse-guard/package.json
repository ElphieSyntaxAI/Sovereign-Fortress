{
  "name": "msgf-pulse-guard",
  "displayName": "MSGF Pulse Guard",
  "description": "V3.2-ULTRA IDE guard — buffers keystroke Pulses and routes to MSGF (SHARD / CROSS-REF / CONVERGE).",
  "version": "0.1.9",
  "publisher": "elphiesyntax",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:msgf.dashboard"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "colors": [
      {
        "id": "msgf.jewel.midnight",
        "description": "MSGF jewel midnight status bar backdrop",
        "defaults": { "dark": "#04140e", "light": "#04140e" }
      },
      {
        "id": "msgf.jewel.stoplight.green",
        "description": "MSGF stoplight green — vibrant emerald",
        "defaults": { "dark": "#10b981", "light": "#059669" }
      },
      {
        "id": "msgf.jewel.stoplight.amber",
        "description": "MSGF stoplight yellow — topaz amber warning",
        "defaults": { "dark": "#f59e0b", "light": "#d97706" }
      },
      {
        "id": "msgf.jewel.stoplight.ruby",
        "description": "MSGF stoplight red — ruby crimson halt",
        "defaults": { "dark": "#ef4444", "light": "#dc2626" }
      },
      {
        "id": "msgf.jewel.stoplight.greenBg",
        "description": "MSGF stoplight green background",
        "defaults": { "dark": "#022c22", "light": "#022c22" }
      },
      {
        "id": "msgf.jewel.stoplight.amberBg",
        "description": "MSGF stoplight amber background",
        "defaults": { "dark": "#1c1408", "light": "#1c1408" }
      },
      {
        "id": "msgf.jewel.stoplight.rubyBg",
        "description": "MSGF stoplight ruby background",
        "defaults": { "dark": "#2a0a0a", "light": "#2a0a0a" }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "msgf-ops",
          "title": "MSGF",
          "icon": "media/msgf.svg"
        }
      ]
    },
    "views": {
      "msgf-ops": [
        {
          "type": "webview",
          "id": "msgf.dashboard",
          "name": "Command Center"
        }
      ]
    },
    "commands": [
      {
        "command": "msgf.flushPulse",
        "title": "MSGF: Flush buffered Pulse now",
        "category": "MSGF"
      },
      {
        "command": "msgf.openDashboard",
        "title": "MSGF: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "msgf.openSignInBrowser",
        "title": "MSGF: Sign in (open browser)"
      },
      {
        "command": "msgf.openWorkspaceIdeSetup",
        "title": "MSGF: Open IDE token setup (browser)"
      },
      {
        "command": "msgf.openDiagnostics",
        "title": "MSGF: Open violation diagnostics"
      },
      {
        "command": "msgf.openUserGuide",
        "title": "MSGF: Open quick reference"
      },
      {
        "command": "msgf.copyHealPrompt",
        "title": "MSGF: Copy agent heal prompt"
      },
      {
        "command": "msgf.generateContextPack",
        "title": "MSGF: Generate 0-token context pack",
        "category": "MSGF"
      },
      {
        "command": "msgf.buildTargetedPrompt",
        "title": "MSGF: Build Targeted Prompt (prompt optimizer)",
        "category": "MSGF"
      },
      {
        "command": "msgf.confirmPackUsed",
        "title": "MSGF: Confirm Pack Used",
        "category": "MSGF"
      },
      {
        "command": "msgf.runVerifyScripts",
        "title": "MSGF: Run verify scripts",
        "category": "MSGF"
      },
      {
        "command": "msgf.runTerminalDiagnostic",
        "title": "MSGF: Run Terminal Diagnostic (Safe Build)",
        "category": "MSGF"
      },
      {
        "command": "msgf.submitVerifyResult",
        "title": "MSGF: Submit verify result"
      },
      {
        "command": "msgf.testConnection",
        "title": "MSGF: Test connection",
        "category": "MSGF"
      },
      {
        "command": "msgf.applyWorkspaceSettings",
        "title": "MSGF: Apply workspace settings from clipboard"
      },
      {
        "command": "msgf.runSetupWizard",
        "title": "MSGF: Run setup wizard"
      },
      {
        "command": "msgf.copyIdeTokenSetup",
        "title": "MSGF: Open IDE token setup (browser)"
      },
      {
        "command": "msgf.openDevKit",
        "title": "MSGF: Open developer kit"
      },
      {
        "command": "msgf.syncDevKit",
        "title": "MSGF: Sync developer kit"
      }
    ],
    "configuration": {
      "title": "MSGF Pulse Guard",
      "properties": {
        "msgf.tenantKey": {
          "type": "string",
          "default": "",
          "description": "Tenant key sent as X-MSGF-Tenant-Key (and x-msgf-tenant-id). Falls back to workspace folder name.",
          "scope": "resource"
        },
        "msgf.authToken": {
          "type": "string",
          "default": "",
          "description": "Personal or service token sent as Authorization: Bearer for POST /api/msgf/pulse.",
          "scope": "resource"
        },
        "msgf.role": {
          "type": "string",
          "enum": ["", "global_admin", "company_admin", "dev"],
          "default": "",
          "description": "V3.2 operator tier (maps to x-msgf-access-role on Pulse requests)."
        },
        "msgf.organizationId": {
          "type": "string",
          "default": "",
          "description": "Team / company silo id (x-msgf-organization-id). When empty with a personal token, sandbox company_admin fallback may apply."
        },
        "msgf.apiUrl": {
          "type": "string",
          "default": "https://elphiesgatedai.elphiesyntax.com",
          "description": "MSGF API base URL (Cloud Run or local Next app) for POST /api/msgf/pulse.",
          "scope": "resource"
        },
        "msgf.devSession": {
          "type": "boolean",
          "default": false,
          "description": "Vibe-coding profile: buffer edits locally and POST Pulse on file save only (x-msgf-dev-session). When false, micro-batch flush every ~3s.",
          "scope": "resource"
        },
        "msgf.licenseKey": {
          "type": "string",
          "default": "",
          "description": "Contract license or service token (Bearer) for IDE Pulse when not using browser session auth.",
          "scope": "resource"
        },
        "msgf.entityId": {
          "type": "string",
          "default": "",
          "description": "Optional stable developer machine id (x-msgf-entity-id). Defaults to a generated id per machine.",
          "scope": "resource"
        },
        "msgf.smallBrainProvider": {
          "type": "string",
          "enum": ["openai", "anthropic", "ollama", "deepseek", "gemini"],
          "default": "gemini",
          "description": "Local Small Brain provider for lightweight IDE-side routing."
        },
        "msgf.smallBrainApiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the configured Small Brain provider (sent as x-msgf-small-brain-api-key on pulse).",
          "scope": "application"
        },
        "msgf.smallBrainModelName": {
          "type": "string",
          "default": "",
          "description": "Model id for Small Brain (e.g. gemini-2.0-flash, gpt-4o-mini). Sent as x-msgf-small-brain-model."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "typecheck": "tsc -p ./ --noEmit",
    "watch": "node esbuild.config.mjs --watch",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
